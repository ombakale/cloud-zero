# =======================================================
# Server Configuration
# =======================================================
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# =======================================================
# Neon Serverless PostgreSQL Database Configuration
# =======================================================
# Neon connection string (Direct endpoint for migrations & schema operations):
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: Neon pooled connection string (recommended for high concurrency & serverless):
DATABASE_URL_POOLED="postgresql://neondb_owner:your_password@ep-cool-snowflake-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Individual connection parameters (alternative to single URL):
PGHOST=ep-cool-snowflake-123456.us-east-2.aws.neon.tech
PGUSER=neondb_owner
PGPASSWORD=your_password
PGDATABASE=neondb
PGPORT=5432
PGSSLMODE=require

# =======================================================
# AWS Credentials & Multi-Account Settings (Optional Defaults)
# Note: Can also be entered dynamically via the dashboard UI!
# =======================================================
# --- AWS Account 1 (Primary Account) ---
AWS_ACCESS_KEY_ID=your_aws_account_1_access_key
AWS_SECRET_ACCESS_KEY=your_aws_account_1_secret_key
AWS_REGION=us-east-1
AWS_ACCOUNT_NAME="AWS Account 1 (Primary)"

# --- AWS Account 2 (Secondary Account) ---
AWS_ACCOUNT_2_ACCESS_KEY_ID=
AWS_ACCOUNT_2_SECRET_ACCESS_KEY=
AWS_ACCOUNT_2_REGION=us-east-1
AWS_ACCOUNT_2_NAME="AWS Account 2"

# Output & Months History
AWS_COST_OUTPUT_FOLDER=./AWSReports
AWS_COST_MONTHS_HISTORY=6

# =======================================================
# Microsoft Azure Credentials (Optional Defaults)
# Note: Can also be entered dynamically via the dashboard UI!
# =======================================================
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_SUBSCRIPTION_ID=

# =======================================================
# Cloudflare R2 Storage (Optional: Azure FOCUS Blobs)
# =======================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
AZURE_COST_R2_PREFIX=

# =======================================================
# Email / Notification Configuration (Optional)
# =======================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Microsoft Graph API sender (if sending via Azure AD)
SENDER_EMAIL=
